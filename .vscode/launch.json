{

  "version": "0.2.0",

  "configurations": [

    {

      "name": "Run PNC Simulator (GUI)",

      "type": "python",

      "request": "launch",

      "program": "${workspaceFolder}/edu_interpreter.py",

      "args": [

        "${file}"

      ],

      "console": "internalConsole",

      "cwd": "${workspaceFolder}"

    },

    {

      "name": "Run PNC Simulator (CLI)",

      "type": "python",

      "request": "launch",

      "program": "${workspaceFolder}/edu_interpreter.py",

      "args": [

        "--cli",

        "${file}"

      ],

      "console": "integratedTerminal",

      "cwd": "${workspaceFolder}"

    }

  ]

}

